<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent (macOS)
    cp deploy/com.nanovoice.stt-server.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.nanovoice.stt-server.plist
    launchctl kickstart -k gui/$(id -u)/com.nanovoice.stt-server   # restart
    launchctl bootout gui/$(id -u)/com.nanovoice.stt-server        # stop / unload
    tail -f /tmp/stt-server.log      (launchd does not expand ~ in log paths; edit to an absolute path if you prefer)
  Secrets are read from ~/.config/stt/env (chmod 600), same file as the systemd unit.
  launchd starts with a minimal PATH, so Homebrew's bin dir (ffmpeg) is added explicitly.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nanovoice.stt-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>set -a; . "$HOME/.config/stt/env"; set +a; exec "$HOME/.local/bin/stt-server"</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/stt-server.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/stt-server.log</string>
</dict>
</plist>
